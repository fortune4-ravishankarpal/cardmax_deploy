{
  "name": "cardMax",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "safe:dev": "rm -rf .next && pnpm gen && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "predev": "pnpm generate:importmap && pnpm generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "seed:one": "tsx -r dotenv/config scripts/seed-one.ts",
    "sync:plugin": "node scripts/sync-plugin.js",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "nuke": "echo y | pnpm payload migrate:fresh && pnpm seed",
    "postnuke": "pnpm gen && pnpm safe:dev",
    "seed": "tsx -r dotenv/config src/seed/seeders/index.seed.ts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payload-bites/audit-fields": "^1.7.0",
    "@payload-pln/soft-delete": "^1.0.3",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "^3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@veiag/payload-enhanced-sidebar": "^0.5.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.88.0",
    "payload-gatekeeper": "^1.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.86.0",
    "sharp": "0.34.2",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "sass": "1.77.4",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}