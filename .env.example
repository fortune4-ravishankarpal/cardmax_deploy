# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE


# OTP (one-time password) login
OTP_PROVIDER=console
OTP_CODE_LENGTH=6
OTP_EXPIRY_MS=300000
OTP_RESEND_COOLDOWN_MS=30000
OTP_MAX_ATTEMPTS=5
OTP_SEND_WINDOW_MS=60000
OTP_SEND_MAX_PER_WINDOW=3
OTP_EMAIL_FROM=CardMax <no-reply@cardmax.local>

# SMS provider for phone OTP (leave blank to use console fallback)
OTP_SMS_PROVIDER=twilio
OTP_SMS_ACCOUNT_SID=
OTP_SMS_AUTH_TOKEN=
OTP_SMS_FROM=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/users/google/callback

# Gmail statement ingestion (uses the Google OAuth client credentials above)
# Optional: separate key used to encrypt Gmail refresh tokens at rest.
# Falls back to PAYLOAD_SECRET if unset. Set a dedicated random value in production.
GMAIL_ENCRYPTION_KEY=
# Optional: custom OAuth redirect URI for the Gmail flow.
# Falls back to http://localhost:3000/api/users/gmail/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/users/gmail/callback
# Optional: external statement parser/reconciliation service (e.g. the FastAPI engine).
# If unset, PDFs are stored in the media collection and statements are marked 'pending'.
STATEMENT_PARSER_ENDPOINT=
# Optional: JSON array overriding the built-in issuer sender/subject patterns.
#GMAIL_ISSUER_PATTERNS=[{"name":"HDFC Bank","senders":["hdfcbank.com"],"subjectPatterns":["Statement"]}]

# Secure card vault (PCI-sensitive card data storage)
# Managed key used to encrypt (AES-256-GCM) stored card data (PAN, cardholder name).
# Keys are NEVER stored in the database or exposed to the frontend.
# In production, set a dedicated random value (at least 32 random characters).
# Falls back to PAYLOAD_SECRET if unset (development only).
CARD_ENCRYPTION_KEY=
# Optional: versioned key map for safe rotation: {"1":"<secret>","2":"<secret>"}
# New ciphertext is written with CARD_ENCRYPTION_CURRENT_KEY_VERSION (default: latest version}.
# CARD_ENCRYPTION_KEYS={"1":"change-me-1","2":"change-me-2"}
# CARD_ENCRYPTION_CURRENT_KEY_VERSION=2

# Session / cookie settings
SESSION_MAX_AGE_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Set to 1 to skip @t3-oss/env validation at startup (troubleshooting only)
#SKIP_ENV_VALIDATION=1
